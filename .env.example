# Stripe (card-only, TRY) — fill with your own keys, never commit real values.
# Secret key: Stripe Dashboard → Developers → API keys (starts with sk_test_ or sk_live_)
STRIPE_SECRET_KEY=REPLACE_WITH_YOUR_STRIPE_SECRET_KEY
# Webhook signing secret (optional): starts with whsec_
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_YOUR_WEBHOOK_SIGNING_SECRET

# Public URL used for Stripe success/cancel redirects (local dev)
PUBLIC_URL=http://localhost:4242
PORT=4242
